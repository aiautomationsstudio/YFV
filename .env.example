# API Configuration
VITE_API_BASE_URL=https://api.yfvplatform.gov.in/v1
VITE_API_TIMEOUT=30000

# Payment Gateway
VITE_PAYMENT_GATEWAY_KEY=your_payment_gateway_key_here
VITE_PAYMENT_GATEWAY_URL=https://payments.example.com

# Google Maps
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# MapMyIndia (Alternative)
VITE_MAPMYINDIA_API_KEY=your_mapmyindia_api_key_here

# Aadhaar Authentication
VITE_UIDAI_API_URL=https://uidai.gov.in/api
VITE_UIDAI_CLIENT_ID=your_client_id_here

# SMS Gateway
VITE_SMS_GATEWAY_URL=https://sms.example.com
VITE_SMS_GATEWAY_KEY=your_sms_gateway_key_here

# WhatsApp Business API
VITE_WHATSAPP_API_URL=https://whatsapp.example.com
VITE_WHATSAPP_API_KEY=your_whatsapp_api_key_here

# Certificate Blockchain (Optional)
VITE_BLOCKCHAIN_ENABLED=false
VITE_BLOCKCHAIN_API_URL=https://blockchain.example.com

# Environment
VITE_ENVIRONMENT=development
VITE_DEBUG_MODE=true

# Feature Flags
VITE_ENABLE_QR_VALIDATION=true
VITE_ENABLE_CARD_CONVERSION=true
VITE_ENABLE_CHATBOT=true
VITE_ENABLE_BIOMETRIC_AUTH=false

# CDN
VITE_CDN_URL=https://cdn.yfvplatform.gov.in

# Analytics
VITE_GOOGLE_ANALYTICS_ID=UA-XXXXXXXXX-X
VITE_ANALYTICS_ENABLED=true
